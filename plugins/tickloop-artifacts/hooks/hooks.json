{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/prefer-tickloop.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Artifact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/sync-builtin-artifacts.sh\""
          }
        ]
      },
      {
        "matcher": "mcp__plugin_tickloop-artifacts_tickloop-artifacts__ArtifactEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/sync-builtin-artifacts.sh\""
          }
        ]
      }
    ]
  }
}
